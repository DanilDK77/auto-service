function renderDash(body){
  const os = DB.orders;
  const today = os.filter(o=>o.date===todayISO() && o.status!=='cancel');
  const active = os.filter(o=>o.status==='new'||o.status==='work');
  const done = os.filter(o=>o.status==='done');
  const revenue = done.reduce((s,o)=>s+o.price,0);
  const days=[]; for(let i=6;i>=0;i--){ const d=new Date(); d.setDate(d.getDate()-i); days.push(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')); }
  const perDay = days.map(d=>os.filter(o=>o.date===d&&o.status!=='cancel').length);
  const maxD = Math.max(1,...perDay);
  const catCount = {};
  os.filter(o=>o.status!=='cancel').forEach(o=>{ const s=DB.services.find(x=>x.id===o.serviceId); const c=s?s.cat:'Прочее'; catCount[c]=(catCount[c]||0)+1; });
  const catArr = Object.entries(catCount).sort((a,b)=>b[1]-a[1]).slice(0,6);
  const maxC = Math.max(1,...catArr.map(x=>x[1]));
  body.innerHTML =
    '<div class="stat-grid">'+
      statCard('Заявок сегодня', today.length, today.filter(o=>o.status==='new').length+' новых в очереди', 'var(--blue)')+
      statCard('Активные', active.length, 'в работе: '+os.filter(o=>o.status==='work').length, 'var(--amber)')+
      statCard('Выполнено всего', done.length, 'конверсия '+Math.round(done.length/Math.max(1,os.length)*100)+'%', 'var(--green)')+
      statCard('Выручка (выполн.)', fmtMoney(revenue), 'по закрытым нарядам', 'var(--cyan)')+
    '</div>'+
    '<div class="chart-panel">'+
      '<div class="chart-card"><h4>Заявки за 7 дней</h4><div class="bars">'+
        days.map((d,i)=>'<div class="bar-col"><b>'+perDay[i]+'</b><div class="bar'+(d===todayISO()?' hot':'')+'" style="height:'+Math.max(4,perDay[i]/maxD*100)+'%"></div><span>'+new Date(d+'T00:00:00').toLocaleDateString('ru-RU',{weekday:'short'})+'</span></div>').join('')+
      '</div></div>'+
      '<div class="chart-card"><h4>Спрос по категориям</h4><div class="legend">'+
        (catArr.length?catArr.map(([c,n])=>{const col=(CATS[c]||{}).c||'#93A3B8';return '<div class="leg"><span class="sw" style="background:'+col+'"></span><span style="min-width:96px;color:var(--muted)">'+esc(c)+'</span><span class="track"><span class="fill" style="width:'+(n/maxC*100)+'%;background:'+col+'"></span></span><b>'+n+'</b></div>';}).join(''):'<span style="color:var(--dim);font-size:13px">Пока нет данных</span>')+
      '</div></div>'+
    '</div>'+
    '<div class="chart-card"><h4>Ближайшая очередь</h4>'+ nearestQueueHTML() +'</div>';
}
