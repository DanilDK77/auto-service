      const ids = DB.orders.filter(o=>o.status==='cancel').map(o=>o.id);
      if(!ids.length){ toast('Отменённых заявок нет','info'); return; }
      confirmModal('Удалить все отменённые заявки ('+ids.length+')?', ()=>bulkDeleteNow(ids, ()=>{drawOrderRows(adm);refreshTabCounts();}));
    };
    $('#saveView').onclick = ()=>{
      promptModal('Название сохранённого вида', 'Например: «Новые на завтра»', name=>{
        DB.views.push({id:uid('v'), name, f:{status:appState.fStatus, date:appState.fDate, q:appState.q}});
