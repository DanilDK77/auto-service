    const msg=$('#sfMsg');
    if(name.length<3||!(price>=0)||!(dur>=5)){ msg.className='form-msg err'; msg.textContent='Заполните название, цену (≥0) и время (≥5 мин).'; return; }
    const data={name,cat:$('#sfCat').value,price,dur,desc:$('#sfDesc').value.trim()};
    if(s) Object.assign(s,data); else DB.services.push(Object.assign({id:uid('svc')},data));
    saveDB(); closeGen(); drawSvcRows(); refreshTabCounts(); syncPublicAfterSvcChange();
    toast(s?'Услуга обновлена':'Услуга добавлена','ok');
  };
}

/* ---------- users admin ---------- */
function renderUsersTab(body){
  body.innerHTML =
    '<div class="toolbar"><div class="search-box"><input id="usrSearch" placeholder="Поиск: имя, email, телефон…" value="'+esc(appState.userQ)+'"></div>'+
    '<span style="margin-left:auto;font-size:13px;color:var(--dim);font-weight:700">Админов: '+DB.users.filter(u=>u.role==='admin').length+' · Клиентов: '+DB.users.filter(u=>u.role==='client').length+'</span></div>'+
    '<div class="data-shell"><table class="dtable"><thead><tr><th>Пользователь</th><th>Email</th><th>Телефон</th><th>Роль</th><th>Заявок</th><th style="width:120px"></th></tr></thead><tbody id="usrBody"></tbody></table></div>';
  $('#usrSearch').addEventListener('input',debounce(e=>{appState.userQ=e.target.value;drawUsrRows();},160));
  drawUsrRows();
}
function drawUsrRows(){
  const q=appState.userQ.trim().toLowerCase();
  const rows=DB.users.filter(u=>!q||[u.name,u.email,u.phone].join(' ').toLowerCase().includes(q));
  $('#usrBody').innerHTML = rows.length?rows.map(u=>{
    const cnt=DB.orders.filter(o=>o.userId===u.id).length;
    const me=u.id===currentUser.id;
    return '<tr style="cursor:default"><td><div style="display:flex;align-items:center;gap:10px"><span class="avatar '+(u.role==='admin'?'adm':'')+'">'+esc(u.name[0].toUpperCase())+'</span><div><b>'+esc(u.name)+'</b>'+(me?' <span style="font-size:11px;color:var(--cyan)">(вы)</span>':'')+'<div class="mono">с '+fmtDate(u.created)+'</div></div></div></td>'+
    '<td class="mono">'+esc(u.email)+'</td><td class="mono">'+esc(u.phone||'—')+'</td>'+
    '<td><span class="role-tag '+u.role+'">'+(u.role==='admin'?'админ':'клиент')+'</span></td>'+
    '<td><b>'+cnt+'</b></td>'+
    '<td><div class="row-actions">'+
      (me?'':('<button class="icon-btn" data-role="'+u.id+'" title="Сменить роль">'+(u.role==='admin'?'↓':'↑')+'</button><button class="icon-btn del" data-ud="'+u.id+'" title="Удалить">🗑</button>'))+
    '</div></td></tr>';
  }).join(''):'<tr><td colspan="6" style="text-align:center;color:var(--dim);padding:32px">Пользователи не найдены</td></tr>';
  $$('#usrBody [data-role]').forEach(b=>b.onclick=()=>{
    const u=DB.users.find(x=>x.id===b.dataset.role); if(!u) return;
    const nr=u.role==='admin'?'client':'admin';
    confirmModal((nr==='admin'?'Выдать права администратора — ':'Снять права администратора у ')+u.name+'?',()=>{
      u.role=nr; saveDB(); drawUsrRows(); toast(u.name+': теперь '+(nr==='admin'?'администратор':'клиент'),'ok');
    });
  });
  $$('#usrBody [data-ud]').forEach(b=>b.onclick=()=>{
    const u=DB.users.find(x=>x.id===b.dataset.ud); if(!u) return;
    confirmModal('Удалить пользователя '+u.name+'? Его заявки останутся в системе.',()=>{
      const i=DB.users.indexOf(u); DB.users.splice(i,1); saveDB(); drawUsrRows(); refreshTabCounts();
      toast('Пользователь удалён','warn',()=>{DB.users.splice(Math.min(i,DB.users.length),0,u);saveDB();drawUsrRows();refreshTabCounts();});
    });
  });
}

function confirmModal(text, onYes){
  openGen('Подтверждение',
    '<p style="font-size:14.5px;color:var(--muted)">'+esc(text)+'</p>'+
    '<div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px">'+
    '<button class="btn btn-ghost" id="cfNo">Отмена</button><button class="btn btn-danger" id="cfYes">Подтвердить</button></div>');
  $('#cfNo').onclick=closeGen;
  $('#cfYes').onclick=()=>{closeGen();onYes();};
}
function promptModal(title, ph, onOk){
  openGen(title,'<div class="field"><input id="pmInput" placeholder="'+esc(ph)+'"></div>'+
    '<div style="display:flex;gap:10px;justify-content:flex-end"><button class="btn btn-ghost" id="pmNo">Отмена</button><button class="btn btn-hot" id="pmOk">Сохранить</button></div>');
  setTimeout(()=>{const i=$('#pmInput'); if(i)i.focus();},60);
  const ok=()=>{const v=$('#pmInput').value.trim(); if(v.length<2){$('#pmInput').style.borderColor='var(--red)';return;} closeGen(); onOk(v);};
  $('#pmOk').onclick=ok; $('#pmNo').onclick=closeGen;
  $('#pmInput').onkeydown=e=>{if(e.key==='Enter')ok();};
}

/* ================= AUTH + INIT ================= */
async function doLogin(e){
  e.preventDefault();
  const email=$('#liEmail').value.trim().toLowerCase(), pass=$('#liPass').value;
  const msg=$('#liMsg');
  const u=DB.users.find(x=>x.email.toLowerCase()===email);
  if(!u){ msg.className='form-msg err'; msg.textContent='Пользователь с таким email не найден.'; return; }
  const h=await hashPass(pass,u.salt);
  if(h!==u.hash){ msg.className='form-msg err'; msg.textContent='Неверный пароль. Попробуйте ещё раз.'; return; }
  linkGuestOrders(u);
  setSession(u); closeAuth();
  $('#loginForm').reset();
  toast('Добро пожаловать, '+u.name.split(' ')[0]+'!','ok');
  showApp();
}
async function doRegister(e){
  e.preventDefault();
  const name=$('#rgName').value.trim(), phone=$('#rgPhone').value.trim(),
        email=$('#rgEmail').value.trim().toLowerCase(), pass=$('#rgPass').value;
  const msg=$('#rgMsg');
  const fail=t=>{msg.className='form-msg err';msg.textContent=t;};
  if(name.length<2) return fail('Укажите имя (минимум 2 символа).');
  if(!validPhone(phone)) return fail('Телефон в формате +7 и 10 цифр.');
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return fail('Некорректный email.');
  if(pass.length<6) return fail('Пароль должен быть не короче 6 символов.');
  if(DB.users.some(u=>u.email.toLowerCase()===email)) return fail('Этот email уже зарегистрирован. Войдите.');
  const salt=Math.random().toString(36).slice(2,12);
  const u={id:uid('usr'),name,email,phone:normPhone(phone),role:'client',salt,hash:await hashPass(pass,salt),created:todayISO()};
  DB.users.push(u); saveDB();
  linkGuestOrders(u);
  setSession(u); closeAuth(); $('#regForm').reset();
  toast('Аккаунт создан. Добро пожаловать!','ok');
  showApp();
}
function linkGuestOrders(u){
  const ph=(u.phone||'').replace(/\D/g,''); if(!ph) return;
  let n=0;
  DB.orders.forEach(o=>{ if(!o.userId && o.phone.replace(/\D/g,'')===ph){ o.userId=u.id; n++; } });
  if(n){ saveDB(); toast('К аккаунту привязано заявок: '+n,'info'); }
}

function bindGlobal(){
  $('#tabLogin').onclick=()=>switchAuth('login');
  $('#tabRegister').onclick=()=>switchAuth('register');
  $$('[data-close-auth]').forEach(b=>b.onclick=closeAuth);
  $$('[data-close-gen]').forEach(b=>b.onclick=closeGen);
  $('#authModal').addEventListener('click',e=>{if(e.target===e.currentTarget)closeAuth();});
  $('#genModal').addEventListener('click',e=>{if(e.target===e.currentTarget)closeGen();});
  $('#drawerScrim').onclick=closeDrawer;
  $('#drawerClose').onclick=closeDrawer;
  addEventListener('keydown',e=>{ if(e.key==='Escape'){closeAuth();closeGen();closeDrawer();$('#navLinks').classList.remove('open');} });
  $('#loginForm').onsubmit=doLogin;
  $('#regForm').onsubmit=doRegister;
  $$('[data-fill]').forEach(c=>c.onclick=()=>{
    const parts=c.dataset.fill.split('|');
    switchAuth('login'); $('#liEmail').value=parts[0]; $('#liPass').value=parts[1]; $('#liMsg').className='form-msg';
  });
  $('#cabinetLink').onclick=e=>{e.preventDefault();showApp();};
  $('#bookForm').onsubmit=submitBooking;
  $('#bkService').onchange=updateSummary;
  $('#bkDate').onchange=()=>{renderSlots();updateSummary();};
  ['bkName','bkPhone','bkCar'].forEach(id=>$('#'+id).addEventListener('input',e=>e.target.closest('.field').classList.remove('invalid')));
  $('#priceSearch').addEventListener('input',debounce(e=>{priceState.q=e.target.value;renderPriceTable();},150));
  ['bkPhone','rgPhone'].forEach(id=>$('#'+id).addEventListener('blur',e=>{ if(validPhone(e.target.value)) e.target.value=normPhone(e.target.value); }));
}

(async function init(){
  DB = loadDBSync();
  if(!DB || DB.v!==1 || !Array.isArray(DB.users) || !Array.isArray(DB.orders) || !Array.isArray(DB.services)){
    DB = await buildSeed(); saveDB();
  }
  restoreSession();
  renderNav();
  renderServices();
  renderPriceTable();
  fillServiceSelect();
  initBookingDates();
  renderSlots();
  updateSummary();
  prefillBooking();
  renderReviews();
  setupNavScroll();
  bindGlobal();
  observeReveals();
  animateCounters();
  addEventListener('storage',e=>{
    if(e.key===DB_KEY && e.newValue){
      try{
        DB=JSON.parse(e.newValue);
        renderPriceTable(); fillServiceSelect(); renderSlots(); updateSummary();
        if(document.body.classList.contains('mode-app')&&currentUser){
          currentUser=DB.users.find(u=>u.id===currentUser.id)||null;
          if(!currentUser){ setSession(null); showSite(); toast('Сессия завершена: аккаунт изменён','warn'); }
          else renderApp();
        }
      }catch(err){}
    }
  });
})();
</script>
