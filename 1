}
function validPhone(v){ return /^\+?[78][\s(\-]*\d{3}[\s)\-]*\d{3}[\s\-]*\d{2}[\s\-]*\d{2}$/.test(v.trim()); }
function normPhone(v){
  const digits = v.replace(/\D/g,'').replace(/^8/,'7');
  if(digits.length!==11) return v.trim();
  return '+7 ('+digits.slice(1,4)+') '+digits.slice(4,7)+'-'+digits.slice(7,9)+'-'+digits.slice(9,11);
}
function markField(input, ok){ input.closest('.field').classList.toggle('invalid', !ok); return ok; }

