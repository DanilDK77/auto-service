function myOrders(){
  if(currentUser.role==='admin') return DB.orders;
  const ph = (currentUser.phone||'').replace(/\D/g,'');
  return DB.orders.filter(o=>o.userId===currentUser.id || (ph && o.phone.replace(/\D/g,'')===ph));
}
function filteredOrders(){
  let rows = myOrders().slice();
  const q = appState.q.trim().toLowerCase();
  if(q) rows = rows.filter(o=>[o.clientName,o.car,o.plate,o.serviceName,String(o.num),o.phone].join(' ').toLowerCase().includes(q));
  const fs = appState.fStatus;
  if(fs==='active') rows = rows.filter(o=>o.status==='new'||o.status==='work');
  else if(fs!=='all') rows = rows.filter(o=>o.status===fs);
  if(appState.fDate==='today') rows = rows.filter(o=>o.date===todayISO());
  if(appState.fDate==='future') rows = rows.filter(o=>o.date>=todayISO());
  const {key,dir} = appState.sort;
  rows.sort((a,b)=>{
    let va=a[key], vb=b[key];
    if(key==='date'){ va=a.date+a.time; vb=b.date+b.time; }
    if(typeof va==='string') return va.localeCompare(vb,'ru')*dir;
    return (va-vb)*dir;
  });
  return rows;
}

