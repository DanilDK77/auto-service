function takenSlots(date){
  return new Set(DB.orders.filter(o=>o.date===date && o.status!=='cancel').map(o=>o.time));
}
function slotMinutes(t){ const [h,m]=t.split(':').map(Number); return h*60+m; }
function renderSlots(){
  const date = $('#bkDate').value;
  const box = $('#bkSlots');
  if(!date){ box.innerHTML='<span style="font-size:13px;color:var(--dim)">Сначала выберите дату</span>'; bkSlot=''; return; }
  const taken = takenSlots(date);
  const now = new Date();
  const isToday = date===todayISO();
  if(bkSlot && taken.has(bkSlot)) bkSlot='';
  box.innerHTML = TIME_SLOTS.map(t=>{
    const past = isToday && slotMinutes(t) <= now.getHours()*60+now.getMinutes();
    const dis = taken.has(t)||past;
    return '<button type="button" class="slot'+(bkSlot===t&&!dis?' on':'')+'" data-t="'+t+'"'+(dis?' disabled':'')+'>'+t+'</button>';
  }).join('');
  $$('#bkSlots .slot:not(:disabled)').forEach(b=>b.onclick=()=>{
    bkSlot=b.dataset.t;
    $$('#bkSlots .slot').forEach(x=>x.classList.toggle('on',x===b));
    updateSummary();
    b.closest('.field').classList.remove('invalid');
  });
}
function updateSummary(){
