let revealObserver = null;
function observeReveals(){
  if(!revealObserver){
    revealObserver = new IntersectionObserver(es=>es.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('in'); revealObserver.unobserve(en.target);} }),{threshold:.12});
  }
  $$('.reveal:not(.in)').forEach(el=>revealObserver.observe(el));
}
function animateCounters(){
  $$('[data-count]').forEach(el=>{
    const target = +el.dataset.count; const t0 = performance.now(); const dur=1600;
    const tick = now=>{
      const p = Math.min(1,(now-t0)/dur); const eased = 1-Math.pow(1-p,3);
      el.textContent = new Intl.NumberFormat('ru-RU').format(Math.round(target*eased)) + (target===98?'%':target>=1000?'+':'');
      if(p<1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
}
function setupNavScroll(){
  const nav = $('#nav');
  const links = $$('.nav-links a[data-nav]');
  const secs = links.map(a=>document.querySelector(a.getAttribute('href'))).filter(Boolean);
  const onScroll = ()=>{
    nav.classList.toggle('scrolled', scrollY>10);
    let cur = null;
    for(const s of secs){ if(s.getBoundingClientRect().top <= 120) cur = s; }
    links.forEach(a=>a.classList.toggle('active', cur && a.getAttribute('href')==='#'+cur.id));
  };
  addEventListener('scroll', onScroll, {passive:true});
  onScroll();
  $('#burger').onclick = ()=>$('#navLinks').classList.toggle('open');
  links.forEach(a=>a.addEventListener('click',()=>$('#navLinks').classList.remove('open')));
}

