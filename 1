      toast('Статус обновлён у '+ids.length+' заявок','ok',()=>{ prev.forEach(p=>{const o=DB.orders.find(x=>x.id===p.id); if(o){o.status=p.s; o.history.push({s:p.s,t:stampNow()});}}); saveDB(); drawOrderRows(adm); refreshTabCounts(); });
    };
    $('#bulkDelete').onclick = ()=>{
      const ids=[...appState.sel]; if(!ids.length) return;
      confirmModal('Удалить выбранные заявки ('+ids.length+')?', ()=>bulkDeleteNow(ids, ()=>{appState.sel.clear();drawOrderRows(adm);refreshTabCounts();}));
