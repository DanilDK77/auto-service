  <section class="sec" id="booking">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="tag">// Онлайн-запись</span>
        <h2>Займите пост за 30 секунд</h2>
        <p>Выберите услугу, дату и свободное окно. Заявка мгновенно появится в системе — статус можно отслеживать в личном кабинете.</p>
      </div>
      <div class="book-grid">
        <div class="panel reveal" id="bookPanel">
          <h3>🔧 Новая заявка</h3>
          <form id="bookForm" novalidate>
            <div class="form-grid">
              <div class="field"><label>Ваше имя *</label><input id="bkName" type="text" placeholder="Иван Петров"><span class="err">Укажите имя</span></div>
              <div class="field"><label>Телефон *</label><input id="bkPhone" type="tel" placeholder="+7 (900) 000-00-00"><span class="err">Формат: +7 и 10 цифр</span></div>
              <div class="field"><label>Марка и модель *</label><input id="bkCar" type="text" placeholder="Toyota Camry"><span class="err">Укажите автомобиль</span></div>
              <div class="field"><label>Госномер</label><input id="bkPlate" type="text" placeholder="А123ВС 777"></div>
              <div class="field"><label>Услуга *</label><select id="bkService"></select><span class="err">Выберите услугу</span></div>
              <div class="field"><label>Дата *</label><input id="bkDate" type="date"><span class="err">Выберите дату (не в прошлом)</span></div>
              <div class="field full"><label>Свободное время *</label><div class="slots" id="bkSlots"></div><span class="err">Выберите время</span></div>
              <div class="field full"><label>Комментарий</label><textarea id="bkNote" placeholder="Стук в передней подвеске на неровностях…"></textarea></div>
            </div>
            <div class="form-msg" id="bkMsg"></div>
            <div style="margin-top:18px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
              <button type="submit" class="btn btn-hot">Создать заявку →</button>
              <span style="font-size:12.5px;color:var(--dim)">Нажимая кнопку, вы соглашаетесь на обработку данных</span>
