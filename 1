      renderOrdersTab(body,adm); toast('Применён вид «'+v.name+'»','info');
    });
    $$('#viewChips [data-rmv]').forEach(b=>b.onclick=()=>{
      const i = DB.views.findIndex(x=>x.id===b.dataset.rmv);
      if(i>-1){ const [rm]=DB.views.splice(i,1); saveDB(); renderOrdersTab(body,adm);
        toast('Вид удалён','warn',()=>{DB.views.splice(i,0,rm);saveDB();renderOrdersTab($('#tabBody'),true);}); }
    });
