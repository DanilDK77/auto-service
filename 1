function toast(msg, type='ok', undoFn=null, ttl=4200){
  const box = $('#toasts');
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  const icons = {ok:'✓', err:'✕', warn:'⚠', info:'ℹ'};
  el.innerHTML = '<span style="flex:none">'+(icons[type]||'ℹ')+'</span><span>'+esc(msg)+'</span>';
  let killed=false;
  const kill = ()=>{ if(killed) return; killed=true; el.classList.add('out'); setTimeout(()=>el.remove(),300); };
  if(undoFn){
    const b = document.createElement('button');
    b.className='undo-btn'; b.textContent='Отменить';
    b.onclick = ()=>{ undoFn(); kill(); };
    el.appendChild(b);
    ttl = 6500;
  }
  box.appendChild(el);
  setTimeout(kill, ttl);
  while(box.children.length>4) box.firstChild.remove();
}

