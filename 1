function stampNow(){ return todayISO()+' '+new Date().toTimeString().slice(0,5); }
function thSort(k,label){
  const arrow = appState.sort.key===k ? (appState.sort.dir===1?' ↑':' ↓') : '';
  return '<th class="sortable" data-k="'+k+'">'+label+arrow+'</th>';
}
function drawOrderRows(adm){
  const rows = filteredOrders();
  const tb = $('#ordBody'); if(!tb) return;
  tb.innerHTML = rows.length ? rows.map(o=>{
    const st = STATUSES[o.status];
    return '<tr data-id="'+o.id+'" class="'+(appState.sel.has(o.id)?'sel':'')+'">'+
      (adm?'<td class="cb-cell"><input type="checkbox" class="cb row-cb" data-id="'+o.id+'"'+(appState.sel.has(o.id)?' checked':'')+'></td>':'')+
      '<td><b style="color:var(--amber)">№'+o.num+'</b></td>'+
      '<td><b>'+esc(o.clientName)+'</b><div class="mono">'+esc(o.phone)+'</div></td>'+
      '<td class="car-cell"><b>'+esc(o.car)+'</b><span>'+esc(o.plate||'без номера')+'</span></td>'+
      '<td style="max-width:220px">'+esc(o.serviceName)+'</td>'+
      '<td class="mono">'+fmtDate(o.date)+'<br><b style="color:var(--text)">'+o.time+'</b></td>'+
      '<td style="font-family:Unbounded;font-size:12.5px;color:var(--amber);white-space:nowrap">'+fmtMoney(o.price)+'</td>'+
      '<td><span class="status '+st.cls+'">'+st.label+'</span></td>'+
      '<td class="act-cell"><div class="row-actions">'+
        '<button class="icon-btn" data-edit="'+o.id+'" title="Редактировать">✎</button>'+
        (adm?'<button class="icon-btn del" data-del="'+o.id+'" title="Удалить">🗑</button>':'')+
      '</div></td></tr>';
  }).join('') : '<tr><td colspan="'+(adm?9:8)+'" style="text-align:center;color:var(--dim);padding:36px;font-weight:600">Заявок не найдено. Измените фильтры или создайте новую заявку.</td></tr>';
  $$('#ordBody tr[data-id]').forEach(tr=>tr.onclick=e=>{ if(e.target.closest('.cb-cell,.act-cell'))return; openOrderDrawer(tr.dataset.id); });
  $$('#ordBody .row-cb').forEach(cb=>cb.onchange=()=>{ cb.checked?appState.sel.add(cb.dataset.id):appState.sel.delete(cb.dataset.id); drawOrderRows(adm); });
  $$('#ordBody [data-edit]').forEach(b=>b.onclick=()=>openOrderEdit(b.dataset.edit));
  $$('#ordBody [data-del]').forEach(b=>b.onclick=()=>{
    const o = DB.orders.find(x=>x.id===b.dataset.del); if(!o) return;
    confirmModal('Удалить заявку №'+o.num+' («'+o.serviceName+'»)?', ()=>bulkDeleteNow([o.id], ()=>{drawOrderRows(adm);refreshTabCounts();}));
  });
  const bb = $('#bulkBar');
  if(bb){
    bb.classList.toggle('show', appState.sel.size>0);
    $('#bulkCnt').textContent = 'Выбрано: '+appState.sel.size;
    const all = $('#selAll'); if(all){ const fr=filteredOrders(); all.checked = fr.length>0 && fr.every(o=>appState.sel.has(o.id)); }
  }
}
function bulkDeleteNow(ids, cb){
  const removed = DB.orders.filter(o=>ids.includes(o.id));
  if(!removed.length) return;
  const positions = removed.map(o=>({o, i:DB.orders.indexOf(o)}));
  DB.orders = DB.orders.filter(o=>!ids.includes(o.id));
  saveDB(); closeDrawer(); cb();
  toast('Удалено заявок: '+removed.length,'warn',()=>{
    positions.sort((a,b)=>a.i-b.i).forEach(({o,i})=>DB.orders.splice(Math.min(i,DB.orders.length),0,o));
    saveDB(); cb(); toast('Заявки восстановлены','ok');
  });
}
function refreshTabCounts(){
  $$('#appTabs .tab').forEach(b=>{
    const cnt = b.querySelector('.cnt'); if(!cnt) return;
    if(b.dataset.tab==='orders') cnt.textContent = currentUser.role==='admin'?DB.orders.filter(o=>o.status==='new').length:myOrders().length;
    if(b.dataset.tab==='services') cnt.textContent = DB.services.length;
    if(b.dataset.tab==='users') cnt.textContent = DB.users.length;
  });
}

/* ---------- order drawer / edit ---------- */
function openOrderDrawer(id){
  const o = DB.orders.find(x=>x.id===id); if(!o) return;
  const adm = currentUser.role==='admin';
  const flow = ['new','work','done'];
  const reached = new Set(o.history.map(h=>h.s));
  const st = STATUSES[o.status];
  const tl = (o.status==='cancel'
    ? [{s:'cancel',label:'Заявка отменена'}]
    : flow.map(s=>({s,label:{new:'Заявка создана',work:'Принята в работу',done:'Работы завершены'}[s]}))
  ).map(step=>{
    const h = [...o.history].reverse().find(x=>x.s===step.s);
    return '<div class="tl-item'+(reached.has(step.s)?' hit':'')+'"><span class="tl-dot"></span><div><b>'+step.label+'</b><span>'+(h?h.t.replace(' ',' · '):'ожидается')+'</span></div></div>';
  }).join('');
  openDrawer('Заказ-наряд №'+o.num,
    '<div style="display:flex;align-items:center;gap:10px"><span class="status '+st.cls+'" style="font-size:13px">'+st.label+'</span>'+
    '<span style="margin-left:auto;font-family:Unbounded;color:var(--amber)">'+fmtMoney(o.price)+'</span></div>'+
    kv('Клиент',esc(o.clientName))+kv('Телефон',esc(o.phone))+kv('Автомобиль',esc(o.car)+(o.plate?' · '+esc(o.plate):''))+
    kv('Услуга',esc(o.serviceName))+kv('Дата',fmtDate(o.date))+kv('Время',o.time)+
    (o.note?'<div style="background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:13px;font-size:13.5px"><b style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);display:block;margin-bottom:5px">Комментарий клиента</b>'+esc(o.note)+'</div>':'')+
    '<div><b style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim)">История статусов</b><div class="timeline" style="margin-top:12px">'+tl+'</div></div>',
    '<button class="btn btn-ghost btn-sm" id="drEdit">✎ Редактировать</button>'+
    (adm
      ? (o.status==='new'?'<button class="btn btn-blue btn-sm" id="drWork">▶ В работу</button>':'')+
        (o.status==='work'?'<button class="btn btn-hot btn-sm" id="drDone">✓ Завершить</button>':'')+
        (o.status!=='cancel'&&o.status!=='done'?'<button class="btn btn-danger btn-sm" id="drCancel">Отменить</button>':'')+
        '<button class="btn btn-danger btn-sm" id="drDel" style="margin-left:auto">🗑</button>'
      : (o.status==='new'?'<button class="btn btn-danger btn-sm" id="drCancel">Отменить заявку</button>':''))
  );
  $('#drEdit').onclick = ()=>openOrderEdit(id);
  const setSt = s=>{ o.status=s; o.history.push({s,t:stampNow()}); saveDB(); openOrderDrawer(id); rerenderCurrentTab(); toast('Заявка №'+o.num+': '+STATUSES[s].label,'ok'); };
  const w=$('#drWork'); if(w) w.onclick=()=>setSt('work');
  const dn=$('#drDone'); if(dn) dn.onclick=()=>setSt('done');
  const c=$('#drCancel'); if(c) c.onclick=()=>confirmModal('Отменить заявку №'+o.num+'?',()=>setSt('cancel'));
  const del=$('#drDel'); if(del) del.onclick=()=>confirmModal('Удалить заявку №'+o.num+'? Действие можно отменить в уведомлении.',()=>bulkDeleteNow([id],()=>rerenderCurrentTab()));
}
function kv(k,v){ return '<div class="kv"><span>'+k+'</span><b>'+v+'</b></div>'; }
function rerenderCurrentTab(){
  const body = $('#tabBody'); if(!body || !document.body.classList.contains('mode-app')) return;
  if(appState.tab==='dash'){ renderDash(body); bindDashOpeners(); }
  else if(appState.tab==='orders') drawOrderRows(currentUser.role==='admin');
  refreshTabCounts();
}
function bindDashOpeners(){ $$('#tabBody [data-open]').forEach(el=>el.onclick=()=>openOrderDrawer(el.dataset.open)); }

function openOrderEdit(id){
  const o = DB.orders.find(x=>x.id===id); if(!o) return;
  const adm = currentUser.role==='admin';
  openGen('Редактирование №'+o.num,
    '<form id="editOrdForm" style="display:flex;flex-direction:column;gap:13px">'+
    '<div class="form-grid">'+
      '<div class="field"><label>Клиент</label><input id="eoName" value="'+esc(o.clientName)+'"'+(adm?'':' disabled')+'></div>'+
      '<div class="field"><label>Телефон</label><input id="eoPhone" value="'+esc(o.phone)+'"></div>'+
      '<div class="field"><label>Автомобиль</label><input id="eoCar" value="'+esc(o.car)+'"></div>'+
      '<div class="field"><label>Госномер</label><input id="eoPlate" value="'+esc(o.plate||'')+'"></div>'+
      '<div class="field full"><label>Услуга</label><select id="eoSvc">'+DB.services.map(s=>'<option value="'+s.id+'"'+(s.id===o.serviceId?' selected':'')+'>'+esc(s.name)+' · '+fmtMoney(s.price)+'</option>').join('')+'</select></div>'+
      '<div class="field"><label>Дата</label><input id="eoDate" type="date" value="'+o.date+'" min="'+todayISO()+'"></div>'+
      '<div class="field"><label>Время</label><select id="eoTime">'+TIME_SLOTS.map(t=>'<option'+(t===o.time?' selected':'')+'>'+t+'</option>').join('')+'</select></div>'+
      (adm?'<div class="field full"><label>Статус</label><select id="eoStatus">'+Object.entries(STATUSES).map(([k,v])=>'<option value="'+k+'"'+(k===o.status?' selected':'')+'>'+v.label+'</option>').join('')+'</select></div>':'')+
      '<div class="field full"><label>Комментарий</label><textarea id="eoNote">'+esc(o.note||'')+'</textarea></div>'+
    '</div><div class="form-msg" id="eoMsg"></div>'+
    '<button class="btn btn-hot" type="submit">Сохранить изменения</button></form>');
  $('#editOrdForm').onsubmit = e=>{
    e.preventDefault();
    const name=$('#eoName').value.trim(), phone=$('#eoPhone').value.trim(), car=$('#eoCar').value.trim(), date=$('#eoDate').value;
    const msg=$('#eoMsg');
    if(name.length<2||car.length<2||!validPhone(phone)||!date){ msg.className='form-msg err'; msg.textContent='Проверьте имя, телефон, автомобиль и дату.'; return; }
    const time=$('#eoTime').value;
    const clash = DB.orders.some(x=>x.id!==o.id && x.date===date && x.time===time && x.status!=='cancel');
    if(clash){ msg.className='form-msg err'; msg.textContent='Окно '+time+' на '+fmtDate(date)+' занято другой заявкой.'; return; }
    const svc = DB.services.find(s=>s.id===$('#eoSvc').value);
    Object.assign(o,{clientName:name,phone:normPhone(phone),car,plate:$('#eoPlate').value.trim().toUpperCase(),
      serviceId:svc.id,serviceName:svc.name,price:svc.price,date,time,note:$('#eoNote').value.trim()});
    if(adm){ const ns=$('#eoStatus').value; if(ns!==o.status){ o.status=ns; o.history.push({s:ns,t:stampNow()}); } }
    saveDB(); closeGen(); rerenderCurrentTab();
    if($('#drawer').classList.contains('open')) openOrderDrawer(o.id);
    toast('Заявка №'+o.num+' обновлена','ok');
  };
}

